{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@rainstormy/comet",
	"version": "2.0.0-beta.0",
	"description": "A linter to ensure that Git commit messages conform to certain standards and conventions declared by a customisable set of rules.",
	"keywords": [
		"actions",
		"commit",
		"conventions",
		"git",
		"github",
		"history",
		"lint",
		"pull-request",
		"standards"
	],
	"bugs": "https://github.com/rainstormy/comet/issues",
	"license": "MIT",
	"author": "Steffen Diswal",
	"repository": {
		"type": "git",
		"url": "https://github.com/rainstormy/comet.git"
	},
	"bin": {
		"comet": "dist/main-cli.mjs"
	},
	"files": [
		"dist/main-cli.mjs"
	],
	"type": "module",
	"imports": {
		"#*": "./src/*"
	},
	"dependencies": {
		"ansis": "catalog:",
		"valibot": "catalog:"
	},
	"devDependencies": {
		"@rainstormy/presets-web": "catalog:",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.22.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "24.19.0",
			"onFail": "download"
		}
	}
}
