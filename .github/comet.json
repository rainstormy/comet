{
	"rules": {
		"noRestrictedTrailers": {
			"level": "error",
			"options": {
				"restrictedKeys": ["co-authored-by"]
			}
		},
		"useAuthorEmailPatterns": {
			"level": "error",
			"options": {
				"patterns": ["\\d+\\+.+@users\\.noreply\\.github\\.com"]
			}
		},
		"useAuthorNamePatterns": {
			"level": "error",
			"options": {
				"patterns": ["\\p{Lu}.*\\s.+", "renovate\\[bot\\]"]
			}
		},
		"useCommitterEmailPatterns": {
			"level": "error",
			"options": {
				"patterns": ["\\d+\\+.+@users\\.noreply\\.github\\.com", "noreply@github\\.com"]
			}
		},
		"useCommitterNamePatterns": {
			"level": "error",
			"options": {
				"patterns": ["\\p{Lu}.*\\s.+", "renovate\\[bot\\]", "GitHub"]
			}
		}
	}
}
